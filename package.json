* {
  box-sizing: border-box;
}

:root {
  --bg: #07111d;
  --bg-alt: #101d33;
  --panel: rgba(15, 25, 38, 0.88);
  --panel-border: rgba(148, 163, 184, 0.15);
  --text: #ebf3ff;
  --muted: #9bb0c8;
  --accent: #42d392;
  --accent-2: #41a7ff;
  --warning: #ffc857;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(65, 167, 255, 0.18), transparent 24%),
    radial-gradient(circle at bottom right, rgba(66, 211, 146, 0.14), transparent 25%),
    var(--bg);
  color: var(--text);
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 72px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  border: 1px solid var(--panel-border);
  background: rgba(9, 17, 29, 0.7);
  backdrop-filter: blur(14px);
  border-radius: 18px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.brand-mark {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #0b1120;
  font-weight: 800;
}

.nav {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

.nav a {
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.nav a:hover {
  color: var(--text);
}

.hero {
  display: grid;
  grid-template-columns: 1.6fr 0.9fr;
  gap: 28px;
  align-items: center;
  padding: 64px 0 32px;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 0;
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.lead {
  margin-top: 18px;
  font-size: 1.08rem;
  line-height: 1.7;
  color: var(--muted);
  max-width: 640px;
}

.cta-row {
  display: flex;
  gap: 16px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.cta-row a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 18px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 700;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.cta-row a:hover {
  transform: translateY(-1px);
}

.primary {
  background: linear-gradient(135deg, var(--accent), #67e9b5);
  color: #06210d;
  box-shadow: 0 20px 35px rgba(66, 211, 146, 0.2);
}

.secondary {
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  border: 1px solid var(--panel-border);
}

.hero-card,
.card,
.feature-item,
.status-card,
.deploy-box {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 22px;
  box-shadow: 0 20px 40px rgba(2, 6, 23, 0.28);
}

.hero-card {
  padding: 28px 22px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(66, 211, 146, 0.15);
  color: #96f3c3;
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.hero-card ul {
  margin: 22px 0 0;
  padding-left: 18px;
  display: grid;
  gap: 12px;
  color: var(--muted);
  line-height: 1.6;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  padding-top: 16px;
}

.card {
  padding: 24px 22px;
}

.tag {
  display: inline-block;
  margin-bottom: 10px;
  color: var(--warning);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.card h2,
.feature-panel h2,
.status-card h2,
.deploy-box h2 {
  margin: 0 0 12px;
  font-size: clamp(1.4rem, 3vw, 2.2rem);
  letter-spacing: -0.05em;
}

.card p,
.feature-item p,
.status-card p,
.deploy-box li {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.feature-panel,
.status-panel,
.deploy-panel {
  margin-top: 26px;
}

.section-header {
  margin-bottom: 18px;
}

.feature-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.feature-item {
  padding: 22px 18px;
}

.feature-item h3 {
  margin: 0 0 12px;
  font-size: 1.08rem;
}

.status-card,
.deploy-box {
  padding: 24px 22px;
}

.deploy-box ol {
  margin: 12px 0 0;
  padding-left: 18px;
  display: grid;
  gap: 8px;
}

@media (max-width: 820px) {
  .hero,
  .info-grid,
  .feature-list {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .nav {
    gap: 10px 16px;
  }
}
